<Window x:Class="对比视频播放器.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:对比视频播放器"
        mc:Ignorable="d"
        Title="对比视频播放器" Height="720" Width="1280"
        Closed="Window_Closed"
        WindowStyle="None" AllowsTransparency="True">
    
    <Grid Background="#1a1a1a">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#222222" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                BorderBrush="#333333" BorderThickness="0 0 0 1">
            <Grid>
                <TextBlock Text="对比视频播放器" Foreground="#AAAAAA" FontSize="12" 
                           VerticalAlignment="Center" Margin="15 0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="32" Height="32" Click="MinimizeButton_Click" 
                            Style="{StaticResource WindowButtonStyle}" ToolTip="最小化">
                        <TextBlock Text="—" FontSize="16" />
                    </Button>
                    <Button Width="32" Height="32" Click="MaximizeButton_Click" 
                            Style="{StaticResource WindowButtonStyle}" ToolTip="最大化">
                        <TextBlock Text="□" FontSize="14" />
                    </Button>
                    <Button Width="32" Height="32" Click="TopmostButton_Click" 
                            Style="{StaticResource WindowButtonStyle}" ToolTip="置顶">
                        <TextBlock Text="📌" FontSize="14" />
                    </Button>
                    <Button Width="32" Height="32" Click="CloseButton_Click" 
                            Style="{StaticResource WindowButtonStyle}" ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <local:VideoPlayerControl x:Name="LeftPlayer" Grid.Column="0" />
            
            <Grid Grid.Column="1" Background="#333333" />
            
            <local:VideoPlayerControl x:Name="RightPlayer" Grid.Column="2" />
        </Grid>
        
        <Border Grid.Row="2" Background="#2a2a2a" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 3">
                    <TextBlock Text="同步控制：" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0 0 12 0" />
                    
                    <Button x:Name="SyncPlayButton" Width="36" Height="36" Click="SyncPlayButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" ToolTip="同时播放">
                        <TextBlock Text="▶" FontSize="18" Foreground="White" />
                    </Button>
                    
                    <Button x:Name="SyncPauseButton" Width="36" Height="36" Click="SyncPauseButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" ToolTip="同时暂停">
                        <TextBlock Text="⏸" FontSize="18" Foreground="White" />
                    </Button>
                    
                    <Button x:Name="SyncStopButton" Width="36" Height="36" Click="SyncStopButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" ToolTip="同时停止">
                        <TextBlock Text="⏹" FontSize="18" Foreground="White" />
                    </Button>
                    
                    <Button x:Name="SyncResetButton" Width="36" Height="36" Click="SyncResetButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" ToolTip="同时重置">
                        <TextBlock Text="↺" FontSize="18" Foreground="White" />
                    </Button>
                    
                    <Button x:Name="SyncProgressButton" Width="36" Height="36" Click="SyncProgressButton_Click" 
                            Style="{StaticResource ControlButtonStyle}" ToolTip="同步进度">
                        <TextBlock Text="⇄" FontSize="18" Foreground="White" />
                    </Button>
                    
                    <Separator Width="1" Height="26" Background="#444444" Margin="15 0" />
                    
                    <TextBlock Text="播放速度：" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0 0 8 0" />
                    <ComboBox x:Name="PlaybackRateCombo" Width="70" Height="28" 
                              SelectionChanged="PlaybackRateCombo_SelectionChanged"
                              Style="{StaticResource ComboStyle}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Background="#222222" />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBoxItem Background="#222222" Foreground="White">0.5x</ComboBoxItem>
                        <ComboBoxItem Background="#222222" Foreground="White" IsSelected="True">1.0x</ComboBoxItem>
                        <ComboBoxItem Background="#222222" Foreground="White">1.25x</ComboBoxItem>
                        <ComboBoxItem Background="#222222" Foreground="White">1.5x</ComboBoxItem>
                        <ComboBoxItem Background="#222222" Foreground="White">2.0x</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 3">
                    <TextBlock Text="分别控制：" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0 0 12 0" />
                    
                    <StackPanel Orientation="Horizontal" Margin="0 0 40 0">
                        <TextBlock Text="【左】" Foreground="#FF6B6B" FontSize="11" VerticalAlignment="Center" Margin="0 0 8 0" />
                        
                        <Button x:Name="LeftBackward5Button" Width="32" Height="32" Click="LeftBackward5Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="后退5秒">
                            <TextBlock Text="⏪" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="LeftBackward30Button" Width="32" Height="32" Click="LeftBackward30Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="后退30秒">
                            <TextBlock Text="⏮" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="LeftPlayButton" Width="32" Height="32" Click="LeftPlayButton_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="播放/暂停">
                            <TextBlock Text="▶" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="LeftForward5Button" Width="32" Height="32" Click="LeftForward5Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="前进5秒">
                            <TextBlock Text="⏩" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="LeftForward30Button" Width="32" Height="32" Click="LeftForward30Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="前进30秒">
                            <TextBlock Text="⏭" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <ComboBox x:Name="LeftSpeedCombo" Width="65" Height="26" 
                                  SelectionChanged="LeftSpeedCombo_SelectionChanged"
                                  Style="{StaticResource ComboStyle}" Margin="8 0 0 0">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Background="#222222" />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBoxItem Background="#222222" Foreground="White">0.5x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White" IsSelected="True">1.0x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">1.25x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">1.5x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">2.0x</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="【右】" Foreground="#4ECDC4" FontSize="11" VerticalAlignment="Center" Margin="0 0 8 0" />
                        
                        <Button x:Name="RightBackward5Button" Width="32" Height="32" Click="RightBackward5Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="后退5秒">
                            <TextBlock Text="⏪" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="RightBackward30Button" Width="32" Height="32" Click="RightBackward30Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="后退30秒">
                            <TextBlock Text="⏮" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="RightPlayButton" Width="32" Height="32" Click="RightPlayButton_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="播放/暂停">
                            <TextBlock Text="▶" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="RightForward5Button" Width="32" Height="32" Click="RightForward5Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="前进5秒">
                            <TextBlock Text="⏩" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <Button x:Name="RightForward30Button" Width="32" Height="32" Click="RightForward30Button_Click" 
                                Style="{StaticResource SideButtonStyle}" ToolTip="前进30秒">
                            <TextBlock Text="⏭" FontSize="14" Foreground="White" />
                        </Button>
                        
                        <ComboBox x:Name="RightSpeedCombo" Width="65" Height="26" 
                                  SelectionChanged="RightSpeedCombo_SelectionChanged"
                                  Style="{StaticResource ComboStyle}" Margin="8 0 0 0">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Background="#222222" />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBoxItem Background="#222222" Foreground="White">0.5x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White" IsSelected="True">1.0x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">1.25x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">1.5x</ComboBoxItem>
                            <ComboBoxItem Background="#222222" Foreground="White">2.0x</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>